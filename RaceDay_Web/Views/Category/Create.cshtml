@model RaceDay_Web.Models.CategoryViewModel

@{
    ViewData["Title"] = "Add Category";
    var events = ViewBag.Events as List<RaceDay_Web.Models.EventViewModel>
                 ?? new List<RaceDay_Web.Models.EventViewModel>();
}

<div class="container mt-4">

    <h2>Add Category</h2>
    <p class="text-muted">Create a race category for one of your events.</p>

    <div class="card shadow-sm mt-3">
        <div class="card-body">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="EventID" class="form-label">
                        Select Event
                    </label>

                    <select asp-for="EventID" class="form-select">
                        <option value="">Select an event</option>

                        @foreach (var eventItem in events)
                        {
                            <option value="@eventItem.EventID">
                                @eventItem.EventName
                            </option>
                        }
                    </select>

                    <span asp-validation-for="EventID"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoryName" class="form-label"></label>

                    <input asp-for="CategoryName"
                           class="form-control"
                           placeholder="e.g. 5km Fun Run" />

                    <span asp-validation-for="CategoryName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Distance" class="form-label">
                        Distance (km)
                    </label>

                    <input asp-for="Distance"
                           type="number"
                           step="0.1"
                           min="0.1"
                           class="form-control"
                           placeholder="e.g. 5" />

                    <span asp-validation-for="Distance"
                          class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">
                    Create Category
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
