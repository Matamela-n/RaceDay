@model RaceDay_Web.Models.ResultViewModel

@{
    ViewData["Title"] = "Edit Result";
}

<div class="container mt-4">

    <h2>Edit Race Result</h2>

    <p class="text-muted">
        Event: <strong>@Model.EventName</strong>
    </p>

    <form asp-controller="OrganiserDashboard"
          asp-action="EditResult"
          asp-route-id="@Model.ResultID"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="ResultID" />
        <input type="hidden" asp-for="EventID" />
        <input type="hidden" asp-for="EnrolmentID" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label class="form-label">Enrolment ID</label>
            <input value="@Model.EnrolmentID"
                   class="form-control"
                   readonly />
        </div>

        <div class="mb-3">
            <label asp-for="FinishTime" class="form-label">
                Finish Time
            </label>

            <input asp-for="FinishTime"
                   type="time"
                   step="1"
                   class="form-control" />

            <span asp-validation-for="FinishTime"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Position" class="form-label">
                Finishing Position
            </label>

            <input asp-for="Position"
                   type="number"
                   min="1"
                   class="form-control" />

            <span asp-validation-for="Position"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Save Changes
        </button>

        <a asp-action="Results"
           asp-route-eventId="@Model.EventID"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
