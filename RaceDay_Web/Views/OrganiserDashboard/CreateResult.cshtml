@model RaceDay_Web.Models.ResultViewModel

@{
    ViewData["Title"] = "Record Result";
}

<div class="container mt-4">

    <h2>Record Race Result</h2>

    <p class="text-muted">
        Event: <strong>@Model.EventName</strong>
    </p>

    <form asp-controller="OrganiserDashboard"
          asp-action="CreateResult"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="EventID" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>

        <div class="mb-3">
            <label asp-for="EnrolmentID" class="form-label">
                Select Participant
            </label>

            <select asp-for="EnrolmentID" class="form-select">
                <option value="0">-- Select a participant --</option>

                @foreach (var enrolment in Model.Enrolments)
                {
                    <option value="@enrolment.EnrolmentID">
                        @(enrolment.Participant?.FirstName ?? "Unknown")
                        @(enrolment.Participant?.LastName ?? "Participant")
                        -
                        @(enrolment.Category?.CategoryName ?? "Unknown category")
                    </option>
                }
            </select>

            <span asp-validation-for="EnrolmentID"
                  class="text-danger">
            </span>

            @if (!Model.Enrolments.Any())
            {
                <p class="text-warning mt-2">
                    No participants are enrolled in this event yet.
                </p>
            }
        </div>

        <div class="mb-3">
            <label asp-for="FinishTime" class="form-label">
                Finish Time
            </label>

            <input asp-for="FinishTime"
                   type="time"
                   step="1"
                   class="form-control" />

            <span asp-validation-for="FinishTime"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="Position" class="form-label">
                Finishing Position
            </label>

            <input asp-for="Position"
                   type="number"
                   min="1"
                   class="form-control"
                   placeholder="e.g. 1" />

            <span asp-validation-for="Position"
                  class="text-danger">
            </span>
        </div>

        <button type="submit"
                class="btn btn-primary"
                disabled="@(!Model.Enrolments.Any())">
            Save Result
        </button>

        <a asp-controller="OrganiserDashboard"
           asp-action="Results"
           asp-route-eventId="@Model.EventID"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
