@model RaceDay_Web.Models.EventViewModel

@{
    ViewData["Title"] = Model.EventName;
}

<div class="container py-4">

    <!-- Back to Events -->
    <a asp-controller="Events"
       asp-action="Index"
       class="btn btn-outline-secondary mb-4">
        &larr; Back to Events
    </a>

    <!-- Event Details -->
    <div class="card shadow-sm">
        <div class="card-body p-4">

            <span class="badge bg-primary mb-3">
                @Model.EventType
            </span>
            @if (!string.IsNullOrWhiteSpace(Model.BannerImagePath))
            {
                <img src="@($"https://localhost:7000{Model.BannerImagePath}")"
                     alt="@Model.EventName"
                     class="img-fluid rounded mb-4"
                     style="width: 100%; max-height: 350px; object-fit: cover;" />
            }
            <h1>@Model.EventName</h1>

            <p class="text-muted">
                <strong>Date:</strong>
                @Model.EventDate.ToString("dd MMMM yyyy, HH:mm")
            </p>

            <p>
                <strong>Location:</strong>
                @Model.Location
            </p>

            <p>@Model.Description</p>

            <hr />

            <!-- Available Categories -->
            <h3 class="mb-3">Available Categories</h3>

            <!-- Success Message -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">
                    @TempData["SuccessMessage"]
                </div>
            }

            <!-- Error Message -->
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["ErrorMessage"]
                </div>
            }

            @if (Model.Categories != null &&
                        Model.Categories.Count > 0)
            {
                <div class="list-group">

                    @foreach (var category in Model.Categories)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-3">

                            <div>
                                <h5 class="mb-1">
                                    @category.CategoryName
                                </h5>

                                <p class="mb-0 text-muted">
                                    Distance: @category.Distance km
                                </p>
                            </div>

                            @if (User.IsInRole("Participant"))
                            {
                                <form asp-controller="Events"
                                      asp-action="Enrol"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="EventID"
                                           value="@Model.EventID" />

                                    <input type="hidden"
                                           name="CategoryID"
                                           value="@category.CategoryID" />

                                    <button type="submit"
                                            class="btn btn-primary">
                                        Enrol
                                    </button>

                                </form>
                            }

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="alert alert-info">
                    No categories are available for this event yet.
                </div>
            }

        </div>
    </div>

</div>
