@model RaceDay_Web.Models.OrganiserResultsViewModel

@{
    ViewData["Title"] = "Race Results";

    var events = ViewBag.Events as List<RaceDay_Web.Models.EventViewModel>
                 ?? new List<RaceDay_Web.Models.EventViewModel>();
}

<div class="container mt-4">

    <h2>Race Results</h2>

    <p class="text-muted">
        View and manage finishing times and positions.
    </p>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- SELECT EVENT -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <form asp-action="Results" method="get">

                <label class="form-label">Select Event</label>

                <div class="input-group">

                    <select name="eventId" class="form-select" required>

                        <option value="">Choose an event</option>

                        @foreach (var eventItem in events)
                        {
                            <option value="@eventItem.EventID"
                                    selected="@(Model?.EventID == eventItem.EventID)">
                                @eventItem.EventName
                            </option>
                        }

                    </select>

                    <button type="submit" class="btn btn-primary">
                        View Results
                    </button>

                </div>

            </form>

        </div>
    </div>

    <!-- DISPLAY SELECTED EVENT RESULTS -->
    @if (Model != null && Model.EventID > 0)
    {
        <div class="d-flex justify-content-between align-items-center mb-3">

            <h4>@Model.EventName</h4>

            <a asp-action="CreateResult"
               asp-route-eventId="@Model.EventID"
               class="btn btn-success">

                + Record Result

            </a>

        </div>

        @if (Model.Results.Any())
        {
            <div class="card shadow-sm">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-dark">

                            <tr>
                                <th>Position</th>
                                <th>Participant</th>
                                <th>Category</th>
                                <th>Finish Time</th>
                                <th>Actions</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var result in Model.Results)
                            {
                                <tr>

                                    <td>
                                        <strong>#@result.Position</strong>
                                    </td>

                                    <td>
                                        @result.ParticipantName
                                    </td>

                                    <td>
                                        @result.CategoryName
                                    </td>

                                    <td>
                                        @result.FinishTime.ToString(@"hh\:mm\:ss")
                                    </td>

                                    <td>

                                        <!-- EDIT RESULT -->
                                        <a asp-action="EditResult"
                                           asp-route-id="@result.ResultID"
                                           class="btn btn-warning btn-sm">

                                            Edit

                                        </a>

                                        <!-- DELETE RESULT -->
                                        <form asp-action="DeleteResult"
                                              asp-route-id="@result.ResultID"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete this result?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-danger btn-sm">

                                                Delete

                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        }
        else
        {
            <div class="alert alert-info">

                No results have been recorded for this event yet.

                Click Record Result to add the first result.

            </div>
        }
    }

    <!-- BACK TO DASHBOARD -->
    <div class="mt-4">

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            Back to Dashboard

        </a>

    </div>

</div>
