@model List<RaceDay_Web.Models.EnrolmentViewModel>

@{
    ViewData["Title"] = "My Enrolments";
}

<div class="container py-4">
    <h1>My Enrolments</h1>
    <p class="text-muted">View your RaceDay event registrations.</p>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="card shadow-sm mt-4">
            <div class="card-body text-center py-5">
                <h4>No enrolments yet</h4>
                <p class="text-muted">
                    You haven't enrolled in any events yet.
                    Browse available events to find your next race.
                </p>
                <a asp-controller="Events" asp-action="Index" class="btn btn-primary">
                    Browse Events
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4 mt-2">
            @foreach (var enrolment in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">
                                @(enrolment.Category?.Event?.EventName
                                                        ?? enrolment.Category?.CategoryName
                                                        ?? $"Enrolment #{enrolment.EnrolmentID}")
                    </h5>

                    @if (enrolment.Category != null)
                            {
                                <p>
                                    <strong>Category:</strong>
                                    @enrolment.Category.CategoryName
                                </p>

                                <p>
                                    <strong>Distance:</strong>
                                    @enrolment.Category.Distance km
                                </p>

                                @if (enrolment.Category.Event != null)
                                {
                                    <p>
                                        <strong>Date:</strong>
                                        @(enrolment.Category.Event.EventDate.ToString("dd MMMM yyyy, HH:mm"))
                                    </p>

                                    <p>
                                        <strong>Location:</strong>
                                        @enrolment.Category.Event.Location
                                    </p>
                                }
                            }

                            <p>
                                <strong>Enrolment ID:</strong>
                                @enrolment.EnrolmentID
                            </p>

                            @if (enrolment.EnrolmentDate.HasValue)
                            {
                                <p>
                                    <strong>Enrolled on:</strong>
                                    @enrolment.EnrolmentDate.Value.ToString("dd MMMM yyyy")
                                </p>
                            }

                            @if (!string.IsNullOrWhiteSpace(enrolment.Status))
                            {
                                <p>
                                    <strong>Status:</strong>
                                    <span class="badge bg-warning text-dark">
                                        @enrolment.Status
                                    </span>
                                </p>
                            }

                            <form asp-controller="Enrolments"
                                  asp-action="Cancel"
                                  asp-route-id="@enrolment.EnrolmentID"
                                  method="post"
                                  onsubmit="return confirm('Are you sure you want to cancel this enrolment?');">

                                @Html.AntiForgeryToken()

                                <button type="submit" class="btn btn-outline-danger w-100">
                                    Cancel Enrolment
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
