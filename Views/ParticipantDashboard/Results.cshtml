@model List<RaceDay_Web.Models.ParticipantResultViewModel>

@{
    ViewData["Title"] = "My Race Results";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>My Race Results</h2>
            <p class="text-muted">View your race performance and finishing positions.</p>
        </div>
        <a asp-controller="ParticipantDashboard"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            You don't have any published race results yet.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Event</th>
                                <th>Category</th>
                                <th>Finishing Position</th>
                                <th>Finish Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var result in Model.OrderBy(r => r.Position))
                            {
                                <tr>
                                    <td>@result.EventName</td>
                                    <td>@result.CategoryName</td>
                                    <td>
                                        <span class="badge bg-primary">
                                            @result.Position
                                        </span>
                                    </td>
                                    <td>
                                        @result.FinishTime.ToString(@"hh\:mm\:ss")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>