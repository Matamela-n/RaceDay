@model RaceDay_Web.Models.ProfileViewModel
@inject IHttpClientFactory HttpClientFactory

@{
    ViewData["Title"] = "My Profile";

    var apiBaseUrl = HttpClientFactory
        .CreateClient("RaceDayApi")
        .BaseAddress?.ToString()?.TrimEnd('/');
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">

            <div class="mb-4">
                <h2>My Profile</h2>
                <p class="text-muted">
                    View and update your personal information.
                </p>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            }

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <!-- Profile Picture -->
                    <div class="text-center mb-4">

                        @if (!string.IsNullOrEmpty(Model.ProfileImagePath))
                        {
                            <img src="@(apiBaseUrl + Model.ProfileImagePath)"
                                 alt="Profile Picture"
                                 class="rounded-circle border"
                                 style="width:130px;height:130px;object-fit:cover;" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-light border d-inline-flex
                                            align-items-center justify-content-center"
                                 style="width:130px;height:130px;">
                                <span class="text-muted">No Photo</span>
                            </div>
                        }

                        <h5 class="mt-3">Profile Picture</h5>

                        <form asp-controller="Profile"
                              asp-action="UploadImage"
                              method="post"
                              enctype="multipart/form-data">

                            @Html.AntiForgeryToken()

                            <input type="file"
                                   name="file"
                                   class="form-control mb-2"
                                   accept=".jpg,.jpeg,.png,.webp"
                                   required />

                            <button type="submit"
                                    class="btn btn-outline-primary">
                                Upload Picture
                            </button>
                        </form>
                    </div>

                    <hr />

                    <!-- Personal Information -->
                    <form asp-controller="Profile"
                          asp-action="Index"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="FirstName"
                                   class="form-label"></label>
                            <input asp-for="FirstName"
                                   class="form-control" />
                            <span asp-validation-for="FirstName"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LastName"
                                   class="form-label"></label>
                            <input asp-for="LastName"
                                   class="form-control" />
                            <span asp-validation-for="LastName"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Email"
                                   class="form-label"></label>
                            <input asp-for="Email"
                                   class="form-control" />
                            <span asp-validation-for="Email"
                                  class="text-danger"></span>
                        </div>

                        <button type="submit"
                                class="btn btn-primary">
                            Save Changes
                        </button>

                        <a asp-controller="ParticipantDashboard"
                           asp-action="Index"
                           class="btn btn-outline-secondary ms-2">
                            Back
                        </a>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

